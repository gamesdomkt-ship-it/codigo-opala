{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": "dist",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/opala",
      "destination": "/index.html"
    },
    {
      "source": "/area-de-membros/admin",
      "destination": "/membros/admin.html"
    },
    {
      "source": "/area-de-membros",
      "destination": "/membros/index.html"
    },
    {
      "source": "/area-de-membros/:path*",
      "destination": "/membros/index.html"
    }
  ]
}
